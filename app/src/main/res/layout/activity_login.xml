<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Space
        android:id="@+id/space_header"
        android:layout_width="360dp"
        android:layout_height="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/space_top"
        android:layout_width="200dp"
        android:layout_height="10dp"
        app:layout_constraintEnd_toStartOf="@+id/space_right"
        app:layout_constraintStart_toEndOf="@+id/space_left"
        app:layout_constraintTop_toBottomOf="@+id/space_header" />

    <Space
        android:id="@+id/space_left"
        android:layout_width="80dp"
        android:layout_height="480dp"
        app:layout_constraintBottom_toTopOf="@+id/space_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_header" />

    <Space
        android:id="@+id/space_right"
        android:layout_width="80dp"
        android:layout_height="480dp"
        app:layout_constraintBottom_toTopOf="@+id/space_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_header" />

    <ImageView
        android:id="@+id/iv_login_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:src="@drawable/delete"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:background="@drawable/rounded_images"
        app:layout_constraintEnd_toStartOf="@+id/space_right"
        app:layout_constraintStart_toEndOf="@+id/space_left"
        app:layout_constraintTop_toBottomOf="@+id/space_top" />

    <Space
        android:id="@+id/space_footer"
        android:layout_width="360dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layout_login_form"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layout_buttons"
        app:layout_constraintEnd_toStartOf="@+id/space_right"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/space_left"
        app:layout_constraintTop_toBottomOf="@+id/iv_login_image">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_student_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="textPassword"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="Name"
                app:layout_constraintBottom_toTopOf="@+id/et_student_number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_heading" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="200dp"
        android:layout_height="35dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/space_bottom"
        app:layout_constraintEnd_toStartOf="@+id/space_right"
        app:layout_constraintStart_toEndOf="@+id/space_left">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/btn_login"
                android:layout_width="85dp"
                android:layout_height="wrap_content"
                android:text="Button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_register"
                android:layout_width="85dp"
                android:layout_height="wrap_content"
                android:text="Button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <Space
        android:id="@+id/space_bottom"
        android:layout_width="200dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toTopOf="@+id/space_footer"
        app:layout_constraintEnd_toStartOf="@+id/space_right"
        app:layout_constraintStart_toEndOf="@+id/space_left" />

</androidx.constraintlayout.widget.ConstraintLayout>