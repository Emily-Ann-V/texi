<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainHeading">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/abyssinicasil_latin</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SubHeading">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/adventpro_medium</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="MainText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="FormText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>

    <style name="LoginFormText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>

    <style name="PrimaryLoginButton">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">110dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="SecondaryLoginButton">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">110dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/grey</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">90dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="SecondaryButton">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">90dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/grey</item>
    </style>

    <style name="Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:scaleX">0.5</item>
        <item name="android:scaleY">0.5</item>
    </style>

    <style name="Link">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/yellow</item>
    </style>

    <style name="Image">
        <item name="android:background">@drawable/rounded_image</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="SearchBar">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">210dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/rounded_search_bar</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="AuthenticationScreen">
        <item name="android:layout_gravity">center_horizontal|center_vertical</item>
        <item name="android:maxWidth">800dp</item>
    </style>
</resources>