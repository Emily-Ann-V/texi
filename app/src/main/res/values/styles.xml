<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PrimaryHeadingText">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/abyssinicasil_latin</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SecondaryHeadingText">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/adventpro_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SmallHeadingText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/adventpro_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PrimaryBodyText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SecondaryBodyText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/adventpro_medium</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LogoutText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/adventpro_medium</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PrimaryFormText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>

    <style name="LoginFormText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>

    <style name="LargePrimaryButton">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">115dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LargeSecondaryButton">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">115dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/grey</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DefaultPrimaryButton">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">90dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DefaultSecondaryButton">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minWidth">90dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/grey</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LargeIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:scaleX">0.55</item>
        <item name="android:scaleY">0.55</item>
    </style>

    <style name="DefaultIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:scaleX">0.5</item>
        <item name="android:scaleY">0.5</item>
    </style>

    <style name="PrimaryLink">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:textColor">@color/yellow</item>
    </style>

    <style name="RoundedImage">
        <item name="android:background">@drawable/bg_rounded_image</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="SearchBar">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_regular</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">210dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/bg_rounded_search_bar</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="AuthenticationScreen">
        <item name="android:layout_gravity">center_horizontal|center_vertical</item>
        <item name="android:maxWidth">800dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/default_horizontal_padding</item>
        <item name="android:paddingTop">@dimen/login_vertical_padding</item>
        <item name="android:paddingEnd">@dimen/default_horizontal_padding</item>
        <item name="android:paddingBottom">@dimen/login_vertical_padding</item>
    </style>
</resources>