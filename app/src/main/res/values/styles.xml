    <style name="DefaultPrimaryButton">
        <item name="android:textSize">@dimen/small_heading_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:minWidth">@dimen/default_button_width</item>
        <item name="android:minHeight">@dimen/default_button_height</item>
        <item name="android:textColor">@drawable/text_button_states</item>
        <item name="android:background">@drawable/bg_primary_button_states</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LargePrimaryButton">
        <item name="android:textSize">@dimen/secondary_heading_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:minWidth">@dimen/large_button_width</item>
        <item name="android:minHeight">@dimen/default_button_height</item>
        <item name="android:textColor">@drawable/text_button_states</item>
        <item name="android:background">@drawable/bg_primary_button_states</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DefaultSecondaryButton">
        <item name="android:textSize">@dimen/small_heading_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:minWidth">@dimen/default_button_width</item>
        <item name="android:minHeight">@dimen/default_button_height</item>
        <item name="android:textColor">@drawable/text_button_states</item>
        <item name="android:background">@drawable/bg_secondary_button_states</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LargeSecondaryButton">
        <item name="android:textSize">@dimen/secondary_heading_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:minWidth">@dimen/large_button_width</item>
        <item name="android:minHeight">@dimen/default_button_height</item>
        <item name="android:textColor">@drawable/text_button_states</item>
        <item name="android:background">@drawable/bg_secondary_button_states</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DefaultIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:scaleX">@dimen/default_icon_scale</item>
        <item name="android:scaleY">@dimen/default_icon_scale</item>
    </style>

    <style name="LargeIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:scaleX">@dimen/large_icon_scale</item>
        <item name="android:scaleY">@dimen/large_icon_scale</item>
    </style>

    <style name="PrimaryLink">
        <item name="android:textSize">@dimen/secondary_body_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:textColor">@color/yellow</item>
    </style>

    <style name="RoundedImage">
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@drawable/bg_rounded_image</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
    </style>

    <style name="RoundedUploadedImage">
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@drawable/bg_rounded_uploaded_image</item>
        <item name="android:clipToOutline" tools:ignore="NewApi">true</item>
    </style>

    <style name="SearchBar">
        <item name="android:textSize">@dimen/small_heading_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:minHeight">@dimen/default_element_height</item>
        <item name="android:minWidth">@dimen/search_bar_width</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="android:textColorHint">@color/dark_grey</item>
        <item name="android:background">@drawable/bg_rounded_search_bar</item>
        <item name="android:clipToOutline" tools:ignore="NewApi">true</item>
    </style>

    <style name="RegisterSpinnerBackground">
        <item name="android:minHeight">@dimen/default_button_height</item>
        <item name="android:background">@drawable/bg_register_spinner</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/extra_small_spacing</item>
    </style>

    <style name="FilterSpinnerBackground">
        <item name="android:minHeight">@dimen/default_button_height</item>
        <item name="android:background">@drawable/bg_rounded_filter_spinner</item>
        <item name="android:clipToOutline" tools:ignore="NewApi">true</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/small_spacing</item>
        <item name="android:layout_marginEnd">@dimen/small_spacing</item>
    </style>

    <style name="RegisterSpinnerText">
        <item name="android:textSize">@dimen/primary_body_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:textColor">@color/grey</item>
    </style>

    <style name="FilterSpinnerText">
        <item name="android:textSize">@dimen/primary_body_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">@dimen/small_spacing</item>
    </style>

    <style name="InquireMessage">
        <item name="android:textSize">@dimen/primary_body_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">@dimen/small_spacing</item>
        <item name="android:minHeight">@dimen/default_element_height</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_rounded_message</item>
        <item name="android:clipToOutline" tools:ignore="NewApi">true</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/medium_spacing</item>
        <item name="android:layout_marginEnd">@dimen/medium_spacing</item>
    </style>

    <style name="AuthenticationScreen">
        <item name="android:layout_gravity">center_horizontal|center_vertical</item>
        <item name="android:maxWidth">@dimen/authentication_screen_max_width</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/large_horizontal_padding</item>
        <item name="android:paddingTop">@dimen/login_vertical_padding</item>
        <item name="android:paddingEnd">@dimen/large_horizontal_padding</item>
        <item name="android:paddingBottom">@dimen/login_vertical_padding</item>
    </style>

    <style name="FragmentScreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/default_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/default_horizontal_padding</item>
    </style>

    <style name="InquireScreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/medium_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/medium_horizontal_padding</item>
    </style>

    <style name="NoBookMessage">
        <item name="android:textSize">@dimen/secondary_heading_text_size</item>
        <item name="android:fontFamily">@font/advent_pro_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:text">@string/no_books_found</item>
        <item name="android:gravity">center</item>
        <item name="android:visibility">invisible</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>