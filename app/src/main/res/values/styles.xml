        <item name="android:textSize">@dimen/small_heading_text_size</item>
        <item name="android:fontFamily">@font/advent_pro_medium</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PrimaryFormText">
        <item name="android:textSize">@dimen/primary_body_text_size</item>
        <item name="android:fontFamily">@font/open_sans_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>

    <style name="LoginFormText">
